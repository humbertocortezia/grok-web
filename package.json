{
  "name": "grok-web",
  "version": "0.2.0",
  "description": "Local web UI for Grok Build CLI — chat, sessions, projects, diffs and MCP in the browser.",
  "license": "MIT",
  "type": "module",
  "author": "Humberto Cortezia",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/humbertocortezia/grok-web-cli.git"
  },
  "keywords": [
    "grok",
    "grok-build",
    "xai",
    "ai-agent",
    "local-first",
    "mcp",
    "cli",
    "web-ui"
  ],
  "bin": {
    "grok-web": "./bin/grok-web.mjs"
  },
  "files": [
    "bin",
    "dist",
    "dist-server"
  ],
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web \"GROK_WEB_UI_PORT=3848 tsx --watch server/server.ts\" \"vite\"",
    "build": "vite build && esbuild server/server.ts --bundle --platform=node --format=esm --target=node20 --outfile=dist-server/server.mjs",
    "start": "node bin/grok-web.mjs",
    "web": "npm start",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build"
  },
  "devDependencies": {
    "@fontsource-variable/geist": "^5.2.0",
    "@fontsource-variable/geist-mono": "^5.2.0",
    "@tailwindcss/vite": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^5.0.0",
    "clsx": "^2.1.1",
    "concurrently": "^10.0.4",
    "esbuild": "^0.25.0",
    "lucide-react": "^1.28.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "smol-toml": "^1.7.1",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4",
    "tsx": "^4",
    "typescript": "^5",
    "vite": "^7"
  }
}
